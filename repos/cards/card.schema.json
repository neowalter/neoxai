{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neox-ai.com/api/repos/card.schema.json",
  "title": "neox-ai author card v1",
  "description": "YAML front matter for repos/cards/<owner>/<repo>.md. Generated from AuthorCardV1 in neoxlink packages/contracts, with additionalProperties set to false on every object.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}\\/(?!\\.\\.?$)[A-Za-z0-9._-]{1,100}$"
    },
    "summary": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "zh-Hans": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "default": [],
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "motor-imagery",
          "ssvep",
          "p300-erp",
          "sleep",
          "emotion",
          "seizure",
          "neurofeedback",
          "artifact-removal",
          "signal-processing",
          "decoding",
          "acquisition-streaming",
          "visualization",
          "dataset-tooling",
          "foundation-model",
          "agent-mcp",
          "closed-loop",
          "other"
        ]
      }
    },
    "modalities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "eeg",
          "emg",
          "ecg",
          "eog",
          "ppg",
          "imu",
          "meg",
          "ecog",
          "seeg",
          "fnirs",
          "mixed"
        ]
      }
    },
    "tags": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "experimental",
        "alpha",
        "beta",
        "stable",
        "maintenance",
        "deprecated"
      ]
    },
    "version": {
      "type": "string"
    },
    "logo": {
      "type": "string",
      "pattern": "^https:\\/\\/(?:raw\\.githubusercontent\\.com|user-images\\.githubusercontent\\.com|avatars\\.githubusercontent\\.com|github\\.com)\\/\\S+$"
    },
    "stack": {
      "default": {},
      "type": "object",
      "properties": {
        "frameworks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "datasets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "hardware": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "install": {
      "default": [],
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "command": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "label",
          "command"
        ],
        "additionalProperties": false
      }
    },
    "run": {
      "type": "object",
      "properties": {
        "colab": {
          "type": "string",
          "format": "uri"
        },
        "docker": {
          "type": "string"
        },
        "demo": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "limitations": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "blockers": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "roadmap": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "maxLength": 160
          },
          "state": {
            "type": "string",
            "enum": [
              "planned",
              "in-progress",
              "done"
            ]
          }
        },
        "required": [
          "item",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "citation": {
      "type": "object",
      "properties": {
        "cff": {
          "type": "boolean"
        },
        "bibtex": {
          "type": "string",
          "maxLength": 2000
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.\\d{4,9}\\/\\S+$"
        }
      },
      "additionalProperties": false
    },
    "contributing": {
      "type": "object",
      "properties": {
        "guide": {
          "type": "string",
          "format": "uri"
        },
        "codeOfConduct": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "maintainers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "github": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "github"
        ],
        "additionalProperties": false
      }
    },
    "changelog": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "summary": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "version",
          "date",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "seo": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "maxLength": 160
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "repo",
    "summary",
    "status",
    "maintainers"
  ],
  "additionalProperties": false
}
